# PostgreSQL připojení – zkopíruj do .env a doplň své údaje
DATABASE_URL=postgresql+psycopg://autobazary:autobazary@localhost:5433/autobazary

# Chování scraperu
SCRAPE_DELAY=1.5          # prodleva mezi requesty (s)
SCRAPE_MAX_PAGES=5        # kolik stránek výsledků projít na jeden portál
SCRAPE_TIMEOUT=20         # timeout requestu (s)
SCRAPE_DETAIL=false       # true = stahovat i detailní stránku každého inzerátu (pomalejší)
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
